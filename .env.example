# ==============================================================================
# Online Fitness Coaching Platform - Environment Variables
# ==============================================================================

# Server Port (Render sets this dynamically, local default: 8080)
PORT=8080

# SQLite CLI Binary Path (Mac/Linux default: /usr/bin/sqlite3)
SQLITE_BIN=/usr/bin/sqlite3

# Optional: PostgreSQL / External Database Configuration (if using PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/fitness_platform
DB_USER=postgres
DB_PASSWORD=
